# ==============================================================================
# FD DESIGN PORTFOLIO BUILDER — ENVIRONMENT CONFIGURATION
# ==============================================================================

# Supabase Client Configuration (Exposed to browser via Vite)
# Get these from your Supabase Project Settings > API:
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-Side Privileged Secrets (Optional, for trusted backend / Edge Functions only)
# NEVER prefix these with VITE_ or expose to the frontend:
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Platform metadata
APP_URL=https://your-domain.com
